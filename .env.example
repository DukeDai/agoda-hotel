# ---------------------------------------------------------------------------
# OTA Hotel Sales System — environment
# Copy to .env and adjust. Every value below has a safe local default.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
PORT=3001
API_BASE_URL=http://localhost:3001
WEB_BASE_URL=http://localhost:3000

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ota_hotel?schema=public

# --- Cache / lock ---------------------------------------------------------
# Leave REDIS_URL empty to fall back to the in-process cache+lock adapter.
# Production must set it: the inventory guard and rate limiter are multi-instance.
REDIS_URL=
CACHE_TTL_SECONDS=120

# --- Supplier: Agoda Demand API -------------------------------------------
# AGODA_MODE=mock  -> high-fidelity in-process simulator (no credentials needed)
# AGODA_MODE=live  -> real Agoda Demand API over HTTPS
AGODA_MODE=mock

# Agoda live credentials (issued after commercial approval / onboarding).
AGODA_BASE_URL=https://api-connectivity.agoda.com
AGODA_API_KEY=
AGODA_USERNAME=
AGODA_PASSWORD=
AGODA_CONTENT_LANGUAGE=en

# Per-endpoint timeouts (seconds). Agoda's own guidance: 30s general,
# 60s Precheck, 120s Booking. Keep them distinct, do NOT collapse to one value.
AGODA_TIMEOUT_CONTENT_SECONDS=30
AGODA_TIMEOUT_SEARCH_SECONDS=30
AGODA_TIMEOUT_PRECHECK_SECONDS=60
AGODA_TIMEOUT_BOOKING_SECONDS=120

# Rate limiting: thresholds are only handed out during onboarding.
AGODA_RATE_LIMIT_RPM=60
AGODA_RATE_LIMIT_BURST=10
AGODA_MAX_RETRIES=3

# MOCK ONLY — probability (0..1) that the mock supplier re-prices an offer at
# precheck time. Set to 1 to demo the "price went up, the customer must
# confirm it" flow against a running system. Ignored in live mode.
AGODA_MOCK_PRICE_DRIFT_RATE=0

# --- Payment (Partner Fulfillment: we collect) -----------------------------
# MOCK | stripe
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret
PAYMENT_CAPTURE_WINDOW_MINUTES=30

# --- Fulfillment model -----------------------------------------------------
# partner = we collect and refund the customer (default for a C-end OTA)
FULFILLMENT_MODE=partner

# --- Notifications ---------------------------------------------------------
# Comma separated channel list, tried in order per event type.
NOTIFY_CHANNELS=email,sms,webhook
NOTIFY_MAX_ATTEMPTS=5
NOTIFY_ESCALATION_THRESHOLD=3
OPS_ALERT_WEBHOOK_URL=
# Signing secret of the ops alert webhook. MUST be changed in production:
# the process refuses to start with the development default.
OPS_ALERT_WEBHOOK_SECRET=ota-ops-alert

# --- Booking confirmation polling -----------------------------------------
# Agoda returns processing:true; we poll Booking Detail until confirmed.
BOOKING_POLL_INTERVAL_SECONDS=15
BOOKING_POLL_MAX_MINUTES=30
